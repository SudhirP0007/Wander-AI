# ---------------------------------------------------------------------
# WanderAI backend — environment configuration

# ---------------------------------------------------------------------

# Server
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed origins for CORS (your frontend URL(s)).
# Leave unset to allow the common local static-server ports out of the box
# (npx serve -> 3000, python http.server -> 8000, Live Server -> 5500,
# Vite-style -> 5173). Set explicitly once you're serving from one place.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Supabase (Project Settings -> API)
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Service role key: server-side ONLY. Grants full DB access, bypasses RLS.
# Never expose this to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- External APIs (all optional at first — routes fall back to mock
# data automatically if a key is missing, so the app runs end-to-end
# without any of these configured) ---

# Google Gemini — itinerary generation (FR-04)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Amadeus — flight & hotel prices (FR-05)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# Google Maps — map view / geocoding (FR-07)
GOOGLE_MAPS_API_KEY=

# OpenWeatherMap — daily weather (FR-08)
OPENWEATHERMAP_API_KEY=
